# =============================================================================
# HERTMANN — variáveis de ambiente
# -----------------------------------------------------------------------------
# Todas as variáveis abaixo são CONFIG: públicas / não sensíveis.
# Nenhum SECRET é necessário nesta etapa — a Storefront API da Hostinger é
# pública e não usa token no navegador.
#
# Qualquer token administrativo que venha a surgir é SECRET: nunca com prefixo
# NEXT_PUBLIC_, nunca commitado, lido só no servidor.
#
# Copie para .env.local para correr o projecto localmente. Na Vercel, as
# NEXT_PUBLIC_* entram no build: mudar uma delas pede um novo deploy.
# =============================================================================

# Config · pública — canal de venda `custom` da loja Hertmann na Hostinger.
# Sem ele, nenhuma peça é vendável e a loja funciona só como vitrine.
NEXT_PUBLIC_HOSTINGER_SALES_CHANNEL_ID=scha_01M2XNKMQ4ZWZ2DY9ZD7MJ8FPK

# Config · pública — Storefront API V2 (opcional; este já é o valor por omissão).
NEXT_PUBLIC_HOSTINGER_STOREFRONT_API_URL=https://api-ecommerce.hostinger.com/v2

# Config · pública — liga a página técnica /produto/homologacao-hostinger,
# ligada ao produto de teste. Usar só em Preview e desenvolvimento; é ignorada
# em produção mesmo que definida.
NEXT_PUBLIC_HOSTINGER_HOMOLOGATION=true

# Config · pública — origem canónica do site. Vazio = automático: na Vercel, o
# domínio de produção do projecto ou o endereço do Preview; localmente,
# http://localhost:3000. Preencher só quando existir o domínio definitivo.
NEXT_PUBLIC_SITE_URL=

# Config · servidor (não sensível) — "true" permite indexação por motores de
# busca, e só em produção. Manter desligado até existir domínio definitivo.
SITE_INDEXABLE=false
