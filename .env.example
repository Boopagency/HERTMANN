# =============================================================================
# HERTMANN — variáveis de ambiente
# -----------------------------------------------------------------------------
# Cada variável está classificada como CONFIG (pública ou não sensível) ou
# SECRET. A loja pública não precisa de nenhum SECRET — a Storefront API da
# Hostinger é pública e não usa token no navegador. O único SECRET é o token
# da API de gestão, usado só pelo painel administrativo, no servidor.
#
# SECRET: nunca com prefixo NEXT_PUBLIC_, nunca commitado, lido só no servidor.
#
# Copie para .env.local para correr o projecto localmente. Na Vercel, as
# NEXT_PUBLIC_* entram no build: mudar uma delas pede um novo deploy.
# =============================================================================

# Config · pública — canal de venda `custom` da loja Hertmann na Hostinger.
# Sem ele, nenhuma peça é vendável e a loja funciona só como vitrine.
NEXT_PUBLIC_HOSTINGER_SALES_CHANNEL_ID=scha_01M2XNKMQ4ZWZ2DY9ZD7MJ8FPK

# Config · pública — Storefront API V2 (opcional; este já é o valor por omissão).
NEXT_PUBLIC_HOSTINGER_STOREFRONT_API_URL=https://api-ecommerce.hostinger.com/v2

# Config · pública — liga a página técnica /produto/homologacao-hostinger,
# ligada ao produto de teste. Usar só em Preview e desenvolvimento; é ignorada
# em produção mesmo que definida.
NEXT_PUBLIC_HOSTINGER_HOMOLOGATION=true

# Config · pública — origem canónica do site. Vazio = automático: na Vercel, o
# domínio de produção do projecto ou o endereço do Preview; localmente,
# http://localhost:3000. Preencher só quando existir o domínio definitivo.
NEXT_PUBLIC_SITE_URL=

# Config · servidor (não sensível) — "true" permite indexação por motores de
# busca, e só em produção. Manter desligado até existir domínio definitivo.
SITE_INDEXABLE=false

# =============================================================================
# Painel administrativo (/admin) — ver docs/admin-implementacao-2026-09-28.md
# -----------------------------------------------------------------------------
# Sem SUPABASE_URL e SUPABASE_PUBLISHABLE_KEY, o painel não existe (404) e o
# site usa só o catálogo de protótipo — é o caso de Production hoje.
# =============================================================================

# Config · servidor — projeto Supabase da HERTMANN (Auth + fichas editoriais).
# A chave publicável é pública por natureza (o RLS decide o acesso), mas fica
# só no servidor: sem NEXT_PUBLIC_, o navegador nunca fala com o Supabase.
# Nenhuma chave secreta do Supabase (service_role / sb_secret_…) é usada.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Config · servidor — motor de e-commerce do painel. Só "hostinger" num
# deploy; o simulado nunca é aceite fora do modo simulado local.
ADMIN_COMMERCE_PROVIDER=hostinger

# Config · servidor — loja Hertmann na Hostinger (não é segredo).
HOSTINGER_STORE_ID=store_01M2XKR3V3JR3YG7QKNRG8NK47

# Config · servidor, opcional — API de gestão (este já é o valor por omissão).
# HOSTINGER_API_URL=https://developers.hostinger.com

# SECRET · só servidor — token da API da Hostinger (hPanel → Conta → API).
# Vale para a CONTA inteira: nunca NEXT_PUBLIC_, nunca commitado, cadastrado na
# Vercel como Sensitive e, de início, só no Preview da branch do painel. O
# painel só o usa numa lista fechada de operações da loja.
HOSTINGER_API_TOKEN=

# Config · só desenvolvimento local e testes — dados e contas SIMULADOS, em
# memória. Ignorada na Vercel (VERCEL=1 desliga-a sempre). Para testar:
#   ADMIN_SIMULATION=true
#   NEXT_PUBLIC_HOSTINGER_SALES_CHANNEL_ID=scha_simulado
#   NEXT_PUBLIC_HOSTINGER_STOREFRONT_API_URL=http://localhost:3000/api/simulacao/storefront
# ADMIN_SIMULATION=
